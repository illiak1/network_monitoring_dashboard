# Network Monitoring Dashboard
#
#   make                    build with Raylib fetched into third_party/ (needs git)
#   make RAYLIB_SYSTEM=1    build against an installed Raylib
#   make run | test | clean
#
# Sections: configuration, flags, platform libraries, Raylib source,
# application build, run, tests, cleanup. Objects, dependency files and
# binaries go to build/. CMakeLists.txt is the alternative build.

# ---- Configuration ----

# Program name, Raylib release to fetch, where to put it, and the output dir.
APP_NAME    := netmon
RAYLIB_TAG  := 5.5
RAYLIB_DIR  ?= third_party/raylib
BUILD       := build

# Every .c file in src/ is part of the program; .d files are the header
# dependency lists written by the compiler (-MMD) and included at the end.
SRCS := $(wildcard src/*.c)
OBJS := $(SRCS:src/%.c=$(BUILD)/%.o)
DEPS := $(OBJS:.o=.d)

# ---- Compiler flags ----

# CC and the optimisation level can be overridden from the environment or
# the command line. The warning set is strict (C99, pedantic, shadowing);
# -MMD -MP emit header dependencies (and phony header targets so a deleted
# header does not break the build).
CC      ?= cc
CFLAGS  ?= -O2
CFLAGS  += -std=c99 -Wall -Wextra -Wpedantic -Wshadow -MMD -MP -Isrc

# ---- Platform libraries ----

# Link libraries Raylib needs on each platform; EXE is the executable suffix.
ifeq ($(OS),Windows_NT)
    EXE     := .exe
    LDLIBS  := -lraylib -lopengl32 -lgdi32 -lwinmm
else ifeq ($(shell uname -s),Darwin)
    EXE     :=
    LDLIBS  := -lraylib -framework OpenGL -framework Cocoa -framework IOKit -framework CoreVideo
else
    EXE     :=
    LDLIBS  := -lraylib -lGL -lm -lpthread -ldl -lrt -lX11
endif

APP := $(BUILD)/$(APP_NAME)$(EXE)

# ---- Raylib source selection ----

# With RAYLIB_SYSTEM=1 the compiler's default search paths are used.
# Otherwise the project builds against the copy fetched into RAYLIB_DIR and
# adds its include and library paths.
ifeq ($(RAYLIB_SYSTEM),1)
    RAYLIB_LIB :=
else
    RAYLIB_LIB := $(RAYLIB_DIR)/src/libraylib.a
    CFLAGS     += -I$(RAYLIB_DIR)/src
    LDFLAGS    += -L$(RAYLIB_DIR)/src
endif

.PHONY: all run test clean distclean

# ---- Application build ----

# Default target: the executable.
all: $(APP)

# Link all objects (and the local Raylib, if used) into the executable.
$(APP): $(OBJS) $(RAYLIB_LIB)
	$(CC) $(OBJS) -o $@ $(LDFLAGS) $(LDLIBS)

# Compile one source file. The Raylib library is a prerequisite so its
# headers exist before the first compile; the build directory is an
# order-only prerequisite (created once, does not trigger rebuilds).
$(BUILD)/%.o: src/%.c $(RAYLIB_LIB) | $(BUILD)
	$(CC) $(CFLAGS) -c $< -o $@

$(BUILD):
	mkdir -p $(BUILD)

# ---- Raylib fetch and build ----

# Shallow clone of the pinned Raylib tag, done once on first use.
$(RAYLIB_DIR)/src/raylib.h:
	git clone --depth 1 --branch $(RAYLIB_TAG) https://github.com/raysan5/raylib.git $(RAYLIB_DIR)

# Static desktop build of the fetched Raylib.
$(RAYLIB_DIR)/src/libraylib.a: $(RAYLIB_DIR)/src/raylib.h
	$(MAKE) -C $(RAYLIB_DIR)/src PLATFORM=PLATFORM_DESKTOP

# ---- Run ----

# Build, then start from build/ so the font lookup finds ../assets/fonts
# (see find_font in src/theme.c).
run: $(APP)
	cd $(BUILD) && ./$(APP_NAME)$(EXE)

# ---- Tests ----

# The simulation layer has no Raylib dependency and is tested headless.
TEST_BIN := $(BUILD)/test_data$(EXE)

# Build and run the tests.
test: $(TEST_BIN)
	./$(TEST_BIN)

# The test binary compiles tests/test_data.c together with src/data.c only,
# with debug info and AddressSanitizer/UndefinedBehaviorSanitizer, so
# memory errors and undefined behaviour in the simulation fail the run.
$(TEST_BIN): tests/test_data.c src/data.c src/data.h | $(BUILD)
	$(CC) -std=c99 -Wall -Wextra -Wpedantic -Wshadow -g -fsanitize=address,undefined -Isrc tests/test_data.c src/data.c -o $@ -lm

# ---- Cleanup ----

# Remove build output; distclean also removes the fetched Raylib.
clean:
	rm -rf $(BUILD)

distclean: clean
	rm -rf third_party

# Header dependency files generated by -MMD (ignored when missing).
-include $(DEPS)
